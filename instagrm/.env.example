# Application
APP_NAME=InstaStream-API
APP_VERSION=2.0.0
DEBUG=false
ENVIRONMENT=production

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=4

# Redis (Optional distributed L2 cache; falls back to in-memory L1 cache if unavailable)
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=3600
L1_CACHE_MAXSIZE=2000
L1_CACHE_TTL=300

# Concurrency & Performance
MAX_CONCURRENT_DOWNLOADS=50
SINGLE_FLIGHT_TIMEOUT=30.0

# Rate Limiting
RATE_LIMIT=120
RATE_LIMIT_PERIOD=60

# yt-dlp Settings
YDL_TIMEOUT=30
YDL_RETRIES=3

# Security & CORS
CORS_ORIGINS=["*"]
ALLOWED_HOSTS=["*"]
