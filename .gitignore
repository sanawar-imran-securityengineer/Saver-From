# ============================================================
#  SaverFrom - monorepo root .gitignore
#  Nested .gitignore files inside each sub-project are also honored.
# ============================================================

# ---------- Secrets / environment ----------
# Never commit real credentials. Keep the .env.example templates only.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
secrets.json

# ---------- Python ----------
.venv/
venv/
ENV/
env/
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---------- Node / JS ----------
node_modules/
.pnpm-store/
.npm/
.cache/
*.tsbuildinfo
dist/
dist-ssr/
build/
out/
.expo/
.vite/

# ---------- Large native binaries ----------
# GitHub rejects files > 100 MB. ffmpeg/ffplay/ffprobe are ~138 MB each,
# so the bundled ffmpeg/yt-dlp toolchain is kept out of the repository.
# Download them again locally (FastFB-Video-Downloader/bin) after cloning.
FastFB-Video-Downloader/bin/
*.exe
*.dll
*.so
*.dylib

# ---------- Test / runtime output (never part of the source) ----------
downloads/
scratch/
tmp/
temp/
*.mp4
*.webm
*.mkv
*.mov
*.avi
*.mp3
*.m4a
*.part
*.ytdl
*.log
logs/
*.sqlite
*.sqlite3
*.db

# ---------- Editors / OS ----------
.idea/
*.suo
*.sw?
.DS_Store
Thumbs.db
desktop.ini

# keep the shared workspace settings
!.vscode/settings.json